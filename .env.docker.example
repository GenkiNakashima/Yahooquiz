# Docker environment variables
# Copy this file to .env.docker and fill in your actual values

# 必須: JWT の署名鍵（未設定だと起動時にエラー）。SECRET_KEY とは別の値を、次のコマンドで生成して設定してください
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
# 必須: Flask のセッション Cookie の署名鍵（未設定だと起動時にエラー）。次のコマンドで生成した値を設定してください
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Firestore は docker-compose.yml の firestore サービス（エミュレーター）を使うため、設定は不要です。
# 本番の Firestore には接続しません（認証情報もマウントしません）。

# ---------------------------------------------------------------------------
# LLM（クイズ生成）設定
#   優先順: Groq の GROQ_MODELS（先頭から順に）→ OpenRouter の無料モデル
#   どちらか一方の API キーがあれば起動できます（両方設定を推奨）
# ---------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# カンマ区切りで優先順に指定。Groq のレート制限はモデルごとなので、1つ目が 429 でも次のモデルは使える
# ※ qwen/qwen3.8-27b は Groq の Preview モデル（予告なく提供終了する可能性あり。終了時は次のモデルへ自動で切り替わる）
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# カンマ区切りで優先順に複数指定（モデルIDが :free で終わる無料モデル）
# ※ 無料モデルは予告なく入れ替わる・提供終了するため、定期的に確認してください。
#    利用可能な無料モデルの確認コマンド:
#    curl -s https://openrouter.ai/api/v1/models | jq -r '.data[].id' | grep ':free$'
#    （JSON モードを使うため、supported_parameters に response_format を含むモデルを推奨）
OPENROUTER_MODELS=
# OpenRouter の推奨ヘッダー（HTTP-Referer / X-Title）。未設定時は既定値を使用
# OPENROUTER_SITE_URL=https://github.com/GenkiNakashima/Yahooquiz
# OPENROUTER_APP_NAME=Yahooquiz

LLM_TIMEOUT_SECONDS=30

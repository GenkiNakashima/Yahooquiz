# Application Configuration
# 必須: Flask のセッション Cookie の署名鍵（未設定だと起動時にエラー）。次のコマンドで生成した値を設定してください
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
PORT=8080

# ---------------------------------------------------------------------------
# LLM（クイズ生成）設定
#   優先順: Groq の GROQ_MODELS（先頭から順に）→ OpenRouter の無料モデル
#   どちらか一方の API キーがあれば起動できます（両方設定を推奨）
# ---------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# カンマ区切りで優先順に指定。Groq のレート制限はモデルごとなので、1つ目が 429 でも次のモデルは使える
# ※ qwen/qwen3.8-27b は Groq の Preview モデル（予告なく提供終了する可能性あり。終了時は次のモデルへ自動で切り替わる）
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# カンマ区切りで優先順に複数指定（モデルIDが :free で終わる無料モデル）
# ※ 無料モデルは予告なく入れ替わる・提供終了するため、定期的に確認してください。
#    利用可能な無料モデルの確認コマンド:
#    curl -s https://openrouter.ai/api/v1/models | jq -r '.data[].id' | grep ':free$'
#    （JSON モードを使うため、supported_parameters に response_format を含むモデルを推奨）
OPENROUTER_MODELS=
# OpenRouter の推奨ヘッダー（HTTP-Referer / X-Title）。未設定時は既定値を使用
# OPENROUTER_SITE_URL=https://github.com/GenkiNakashima/Yahooquiz
# OPENROUTER_APP_NAME=Yahooquiz

LLM_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Firestore 設定
#   ローカル開発では必ず Firestore エミュレーターを使います（本番の Firestore には接続しません）。
#   FIRESTORE_EMULATOR_HOST が未設定、またはエミュレーターに接続できない場合、アプリは起動時にエラーで止まります。
#   エミュレーターの起動方法は README の「ローカル開発」を参照（Java 21 が必要）。
#   本番（Cloud Run 上）では Cloud Run が自動で設定する K_SERVICE で判別し、サービスアカウントで本番に接続します。
# ---------------------------------------------------------------------------
FIRESTORE_EMULATOR_HOST=localhost:8085
# エミュレーター用のプロジェクト ID（"demo-" で始まる ID は実在するプロジェクトに対応しない）
GOOGLE_CLOUD_PROJECT=demo-yahooquiz

# JWT Configuration
# 必須: JWT の署名鍵（未設定だと起動時にエラー）。SECRET_KEY とは別の値を、次のコマンドで生成して設定してください
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Environment
FLASK_ENV=production
FLASK_DEBUG=0

# 注意: K_SERVICE は Cloud Run が自動で設定する変数で、本番の判別に使います。ローカルでは設定しないでください
#       （設定すると本番として扱われ、エミュレーターのチェックが行われません）。

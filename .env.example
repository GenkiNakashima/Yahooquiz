# Application Configuration
SECRET_KEY=your-secret-key-change-this-in-production
PORT=8080

# ---------------------------------------------------------------------------
# LLM（クイズ生成）設定
#   メイン: Cerebras / フォールバック: OpenRouter の無料モデル
#   どちらか一方の API キーがあれば起動できます（両方設定を推奨）
# ---------------------------------------------------------------------------
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=qwen-3.8-27b

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# カンマ区切りで優先順に複数指定（モデルIDが :free で終わる無料モデル）
# ※ 無料モデルは予告なく入れ替わる・提供終了するため、定期的に確認してください。
#    利用可能な無料モデルの確認コマンド:
#    curl -s https://openrouter.ai/api/v1/models | jq -r '.data[].id' | grep ':free$'
#    （JSON モードを使うため、supported_parameters に response_format を含むモデルを推奨）
OPENROUTER_MODELS=
# OpenRouter の推奨ヘッダー（HTTP-Referer / X-Title）。未設定時は既定値を使用
# OPENROUTER_SITE_URL=https://github.com/GenkiNakashima/Yahooquiz
# OPENROUTER_APP_NAME=Yahooquiz

LLM_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Firestore（firebase-admin）設定
#   認証は Application Default Credentials（ADC）を使用します。
#   - Cloud Run 上: サービスアカウントで自動的に認証されるため設定不要
#   - ローカル: `gcloud auth application-default login` を実行するか、
#               GOOGLE_APPLICATION_CREDENTIALS にサービスアカウントキーのパスを指定
#   プロジェクトを自動判定できない場合は GOOGLE_CLOUD_PROJECT を指定してください。
# ---------------------------------------------------------------------------
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production

# Environment
FLASK_ENV=production
FLASK_DEBUG=0

# Cloud Run specific (optional, auto-set by Cloud Run)
# GCP_PROJECT=your-gcp-project-id
# K_SERVICE=yahooquiz
# K_REVISION=yahooquiz-00001
